  "langkah_resep": [
    {
      "nama_resep": "kompos",
      "urutan": 1,
      "detail_langkah": "Siapkan wadah yang sudah dimodifikasi sesuai daftar alat yang perlu dimodifikasi di halaman ini."
    },
    {
      "nama_resep": "kompos",
      "urutan": 2,
      "detail_langkah": "Masukkan sampah organik dan bahan pendukung lainnya ke wadah. Susun berlapis-lapis selang-seling dengan bahan pendukung kering sesuai takaran aplikasi."
    },
    {
      "nama_resep": "kompos",
      "urutan": 3,
      "detail_langkah": "Simpan wadah di tempat yang teduh (tidak terkena sinar matahari langsung dan tidak terkena hujan), bersuhu ruang, bersirkulasi udara baik, dan diletakkan di atas permukaan yang datar serta stabil."
    },
    {
      "nama_resep": "kompos",
      "urutan": 4,
      "detail_langkah": "Aduk tumpukan kompos setiap 4 hari sekali supaya udaranya lancar dan kompos tidak berbau busuk."
    },
    {
      "nama_resep": "kompos",
      "urutan": 5,
      "detail_langkah": "Menjelang 7 hari terakhir sebelum jadwal matang, notifikasi pengingat untuk mengaduk tumpukan kompos akan berhenti dengan sendirinya. Ini menandai dimulainya masa curing: JANGAN aduk sama sekali selama periode ini, biarkan kompos beristirahat agar proses pematangan berjalan sempurna."
    },
    {
